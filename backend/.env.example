# Perito v6 — Environment Configuration Template
# Copy this file to .env and fill in actual values (do NOT commit .env to git)

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string for the application database
DATABASE_URL=postgresql://perito:password@localhost:5432/perito_db

# ============================================================================
# APPLICATION
# ============================================================================
# Flask/FastAPI environment (development, staging, production)
ENV=development

# API secret key for sessions and signing
SECRET_KEY=your-secret-key-here-min-32-chars

# ============================================================================
# SMTP Configuration — Email Service Integration
# ============================================================================
# SMTP server hostname (e.g., Gmail, AWS SES, Outlook)
# For Gmail: use smtp.gmail.com
# For AWS SES: use email-smtp.region.amazonaws.com
# For other providers: contact their support
SMTP_HOST=smtp.gmail.com

# SMTP server port (typically 587 for TLS, 465 for SSL, 25 for plain)
# Gmail uses 587 (TLS/STARTTLS) — recommended
SMTP_PORT=587

# SMTP authentication username (sender email address)
# For Gmail: your full email (e.g., ipcms@ipcms.com.br)
# For AWS SES: your SES verified sender email
# NOTE: Do NOT use your personal Gmail password — use an app-specific password
# Generate Gmail app password: https://myaccount.google.com/apppasswords
SMTP_USER=ipcms@ipcms.com.br

# SMTP authentication password
# CRITICAL: This is an app-specific password, NOT your main Gmail password
# To generate for Gmail:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already enabled)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Select "Mail" and "Windows Computer" (or your device)
#   5. Copy the 16-character password and paste here
# NEVER commit the actual password to git — only .env.example gets committed
SMTP_PASS=your-app-specific-password-here

# Email sender display name and address (used in "From:" header)
# Format: "sender_name@domain.com"
# This email must be verified or authenticated with your SMTP provider
SMTP_FROM=ipcms@ipcms.com.br

# SMTP connection timeout in seconds (how long to wait before giving up)
# Default 10 seconds — increase if your server is slow/distant
SMTP_TIMEOUT=10

# Administrator email address (receives error notifications)
# This is where system errors and critical notifications are sent
EMAIL_ADMIN=bruno@ipcms.com.br

# Enable SMTP debug mode (logs all SMTP commands and responses)
# Use "true" during development to troubleshoot email issues
# Set to "false" in production to avoid logging sensitive data
EMAIL_DEBUG=false

# ============================================================================
# Optional: Other Service Integrations (add as needed)
# ============================================================================
# AWS S3 for document storage
# AWS_S3_BUCKET=perito-docs-prod
# AWS_S3_REGION=us-east-1

# Azure Key Vault for secrets management
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/

# Redis cache (optional, for session storage or caching)
# REDIS_URL=redis://localhost:6379/0
