+class SetorPericia(str, enum.Enum):
+    """Setores oficiais da empresa. Fonte única de verdade: v6/SETORES.md.
+
+    Coluna `Processo.setor` é armazenada como texto (nome), não código —
+    todo o app (dashboard.py, processos.py, valores.py) filtra por
+    igualdade de string com estes nomes. NÃO trocar para int sem migrar
+    todos os call-sites. NÃO inventar setor novo sem atualizar SETORES.md.
+    """
+    CONTABIL = "Contábil"
+    DNA = "DNA"
+    ENGENHARIA = "Engenharia"
+    GRAFOTECNICA = "Grafotécnica"
+    MULTIDISCIPLINAR = "Multidisciplinar"
+    DECLINA = "Declina"
+
+    @classmethod
+    def codigo(cls, setor: "SetorPericia | str") -> int:
+        """Código numérico canônico (10-60), conforme SETORES.md."""
+        mapa = {
+            cls.CONTABIL: 10, cls.DNA: 20, cls.ENGENHARIA: 30,
+            cls.GRAFOTECNICA: 40, cls.MULTIDISCIPLINAR: 50, cls.DECLINA: 60,
+        }
+        return mapa[cls(setor)]
+
+    @classmethod
+    def valores(cls) -> list[str]:
+        return [s.value for s in cls]
