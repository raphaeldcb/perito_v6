+"""Testes do enum SetorPericia (Task 4 bônus — limpeza do campo área/setor).
+
+NOTA: não existe tabela `pericias` neste schema (o plano original assumia
+isso). O campo real e equivalente é `Processo.setor`. Ver
+app/models/processo.py:SetorPericia e SETORES.md.
+"""
+
+import pytest
+from pydantic import ValidationError
+
+from app.models.processo import Processo, SetorPericia
+from app.routes.processos import ProcessoCreate, ProcessoUpdate
+
+
+def test_setor_pericia_valores_canonicos():
+    """Os 6 setores oficiais de SETORES.md, nem mais nem menos."""
+    assert SetorPericia.valores() == [
+        "Contábil", "DNA", "Engenharia", "Grafotécnica", "Multidisciplinar", "Declina",
+    ]
+
+
+def test_setor_pericia_codigo():
+    """Códigos numéricos batem com SETORES.md (10-60)."""
+    assert SetorPericia.codigo(SetorPericia.CONTABIL) == 10
+    assert SetorPericia.codigo(SetorPericia.DNA) == 20
+    assert SetorPericia.codigo(SetorPericia.ENGENHARIA) == 30
+    assert SetorPericia.codigo(SetorPericia.GRAFOTECNICA) == 40
+    assert SetorPericia.codigo(SetorPericia.MULTIDISCIPLINAR) == 50
+    assert SetorPericia.codigo(SetorPericia.DECLINA) == 60
+    # aceita string também
+    assert SetorPericia.codigo("DNA") == 20
+
+
+def test_setor_pericia_codigo_invalido_levanta():
+    with pytest.raises(ValueError):
+        SetorPericia.codigo("SIMPLES")
+
+
+# --- Validação nos schemas Pydantic (ProcessoCreate / ProcessoUpdate) ---
+
+def test_processo_create_aceita_setor_valido():
+    p = ProcessoCreate(numero_cnj="123", empresa_id=1, setor="DNA")
+    assert p.setor == "DNA"
+
+
+@pytest.mark.parametrize("lixo", ["SIMPLES", "MÉDIO", "COMPLEXO", "lixo", "VARA ÚNICA", "14657"])
+def test_processo_create_rejeita_setor_sujo(lixo):
+    with pytest.raises(ValidationError):
+        ProcessoCreate(numero_cnj="123", empresa_id=1, setor=lixo)
+
+
+def test_processo_update_aceita_setor_none():
+    """PATCH sem mexer no setor deve continuar permitido (campo opcional)."""
+    p = ProcessoUpdate(setor=None)
+    assert p.setor is None
+
+
+def test_processo_update_rejeita_setor_sujo():
+    with pytest.raises(ValidationError):
+        ProcessoUpdate(setor="COMPLEXO")
+
+
+def test_processo_update_aceita_setor_valido():
+    p = ProcessoUpdate(setor="Grafotécnica")
+    assert p.setor == "Grafotécnica"
+
+
+# --- Persistência real (SQLite in-memory via fixture db_session do conftest) ---
+
+def test_processo_persiste_setor_canonico(db_session):
+    p = Processo(numero_cnj="TEST-ENUM-001", especialidade="DNA", setor=SetorPericia.DNA.value)
+    db_session.add(p)
+    db_session.commit()
+
+    salvo = db_session.query(Processo).filter_by(numero_cnj="TEST-ENUM-001").first()
+    assert salvo.setor == "DNA"
+    assert salvo.setor in SetorPericia.valores()
+
+
+def test_processo_filtra_por_setor(db_session):
+    db_session.add_all([
+        Processo(numero_cnj="TEST-ENUM-002", setor=SetorPericia.ENGENHARIA.value),
+        Processo(numero_cnj="TEST-ENUM-003", setor=SetorPericia.DNA.value),
+    ])
+    db_session.commit()
+
+    eng = db_session.query(Processo).filter(Processo.setor == "Engenharia").all()
+    assert {p.numero_cnj for p in eng} == {"TEST-ENUM-002"}
