@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""Migra/normaliza o campo `Processo.setor` para o enum canônico (SetorPericia).
+
+NOTA HISTÓRICA (17/08/26): o plano original desta task assumia uma tabela
+`pericias.area` com lixo tipo SIMPLES/MÉDIO/COMPLEXO. Essa tabela não existe
+neste schema — o campo real e equivalente é `processo.setor` (texto livre),
+com `processo.especialidade` como sinal auxiliar para classificar setor
+quando setor está vazio. Ver app/models/processo.py:SetorPericia e SETORES.md.
+
+Investigação em produção (VPS, banco perito_v6, 17/08/26) mostrou que o
+banco foi resetado recentemente (188 processos, não mais os ~6900 antigos) e
+NÃO havia mais lixo tipo SIMPLES/MÉDIO/COMPLEXO — só 100% de `setor` vazio.
+Este script:
+
+1. Normaliza variações de caixa/espaço de valores já canônicos em `setor`
+   (defensivo, caso reapareçam via import futuro).
+2. Preenche `setor` a partir de `especialidade` SOMENTE nos mapeamentos de
+   alta confiança abaixo (documentados e revisáveis). Especialidades fora
+   dessa lista (ex.: "Medicina Legal") ou vazias são deixadas como estão —
+   não adivinha classificação de negócio sem confirmação do Bruno (mesmo
+   critério usado em 28/07, ver memory ui_ajustes_perito_280726.md).
+
+Uso:
+    python scripts/migrate_area_enum.py                # dry-run (só mostra)
+    python scripts/migrate_area_enum.py --apply         # aplica de fato
+    DATABASE_URL=postgresql://... python scripts/migrate_area_enum.py --apply
+"""
+
+import argparse
+import os
+import sys
+
+from sqlalchemy import create_engine, text
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from app.models.processo import SetorPericia  # noqa: E402
+
+DATABASE_URL = os.getenv("DATABASE_URL", "sqlite:///./v6.db")
+
+# especialidade (texto livre) -> setor canônico (alta confiança apenas)
+ESPECIALIDADE_PARA_SETOR = {
+    "DNA": SetorPericia.DNA.value,
+    "Avaliação Imobiliária": SetorPericia.ENGENHARIA.value,
+    "Engenharia Elétrica": SetorPericia.ENGENHARIA.value,
+    "Engenharia Civil": SetorPericia.ENGENHARIA.value,
+    "Automotiva": SetorPericia.ENGENHARIA.value,
+    "Segurança do Trabalho": SetorPericia.ENGENHARIA.value,
+}
+
+CANONICOS = SetorPericia.valores()
+
+
+def migrate(apply: bool = False) -> None:
+    engine = create_engine(DATABASE_URL)
+
+    with engine.begin() as conn:
+        print(f"Conectado em: {engine.url.render_as_string(hide_password=True)}\n")
+
+        # --- 1. estado atual ---
+        print("=== ANTES ===")
+        rows = conn.execute(
+            text("SELECT especialidade, setor, COUNT(*) c FROM processo "
+                 "GROUP BY especialidade, setor ORDER BY c DESC")
+        ).fetchall()
+        for r in rows:
+            print(f"  especialidade={r[0]!r:30} setor={r[1]!r:15} n={r[2]}")
+        if not rows:
+            print("  (tabela processo vazia)")
+
+        # --- 2. normalizar caixa/espaço em valores já canônicos ---
+        normalizados = 0
+        for canon in CANONICOS:
+            result = conn.execute(
+                text("UPDATE processo SET setor = :canon "
+                     "WHERE setor IS NOT NULL AND TRIM(setor) != '' "
+                     "AND setor != :canon AND LOWER(TRIM(setor)) = LOWER(:canon)"),
+                {"canon": canon},
+            )
+            normalizados += result.rowcount or 0
+
+        # --- 3. preencher setor vazio a partir de especialidade (alta confiança) ---
+        preenchidos = 0
+        for especialidade, setor in ESPECIALIDADE_PARA_SETOR.items():
+            result = conn.execute(
+                text("UPDATE processo SET setor = :setor "
+                     "WHERE especialidade = :especialidade "
+                     "AND (setor IS NULL OR TRIM(setor) = '')"),
+                {"setor": setor, "especialidade": especialidade},
+            )
+            preenchidos += result.rowcount or 0
+
+        # --- 4. flagar o que ficou fora do enum ou sem classificação ---
+        pendentes = conn.execute(
+            text("SELECT especialidade, COUNT(*) c FROM processo "
+                 "WHERE setor IS NULL OR TRIM(setor) = '' "
+                 "GROUP BY especialidade ORDER BY c DESC")
+        ).fetchall()
+
+        print(f"\n✅ Normalizados (caixa/espaço): {normalizados}")
+        print(f"✅ Preenchidos via especialidade (alta confiança): {preenchidos}")
+        print(f"\n⚠️  AINDA SEM setor (precisa decisão de negócio, não adivinhado):")
+        if pendentes:
+            for r in pendentes:
+                print(f"  especialidade={r[0]!r:30} n={r[1]}")
+        else:
+            print("  (nenhum)")
+
+        print("\n=== DEPOIS ===")
+        rows = conn.execute(
+            text("SELECT especialidade, setor, COUNT(*) c FROM processo "
+                 "GROUP BY especialidade, setor ORDER BY c DESC")
+        ).fetchall()
+        for r in rows:
+            print(f"  especialidade={r[0]!r:30} setor={r[1]!r:15} n={r[2]}")
+
+        if not apply:
+            print("\n🔎 DRY-RUN — nenhuma alteração persistida (rollback automático). "
+                  "Rode com --apply para gravar.")
+            raise _Rollback()
+
+
+class _Rollback(Exception):
+    """Usado só para forçar rollback do `engine.begin()` em modo dry-run."""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--apply", action="store_true", help="Aplica as mudanças (default: dry-run)")
+    args = parser.parse_args()
+
+    try:
+        migrate(apply=args.apply)
+    except _Rollback:
+        pass
+    print("\n✅ Migração concluída!" if args.apply else "\n✅ Dry-run concluído.")
+
+
+if __name__ == "__main__":
+    main()
