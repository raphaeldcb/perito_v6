diff --git a/v6/backend/app/services/llm_router.py b/v6/backend/app/services/llm_router.py
new file mode 100644
index 0000000..b8ac984
--- /dev/null
+++ b/v6/backend/app/services/llm_router.py
@@ -0,0 +1,186 @@
+"""LLM Router — fallback automático Claude -> Qwen (local Ollama -> 9router).
+
+Problema que resolve: quando a cota da API Claude estoura (HTTP 429) ou a
+chamada falha por qualquer outro motivo, o sistema não pode simplesmente
+quebrar. Este módulo tenta Claude primeiro e cai automaticamente para Qwen
+(perito-qwen local via Ollama; se o Ollama local estiver fora do ar, tenta
+Qwen via 9router em :20128) sem exigir troca manual em nenhum lugar do código.
+
+Uso:
+    from app.services.llm_router import get_llm_response
+
+    resposta = await get_llm_response("prompt aqui")
+    resposta["content"]      # texto da resposta
+    resposta["model"]        # "claude" | "qwen-ollama" | "qwen-9router"
+"""
+import os
+import json
+import logging
+from typing import Optional
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+# Claude (Anthropic direto — mesmo padrão usado em auditor_fable.py)
+ANTHROPIC_API_KEY = os.getenv("ANTHROPIC_API_KEY")
+CLAUDE_MODEL = os.getenv("CLAUDE_MODEL", "claude-3-5-sonnet-20241022")
+
+# Qwen local via Ollama nativo (Mac) — mesmo host usado em cerebro_intelligence.py
+OLLAMA_URL = os.getenv("OLLAMA_URL", "http://localhost:11434")
+OLLAMA_MODEL = os.getenv("OLLAMA_MODEL", "perito-qwen")
+
+# Fallback secundário: 9router (gateway local multi-provider em :20128)
+LLM_ROUTER_URL = os.getenv("LLM_ROUTER_URL", "http://localhost:20128")
+LLM_ROUTER_API_KEY = os.getenv("LLM_ROUTER_API_KEY", "")
+LLM_ROUTER_QWEN_MODEL = os.getenv("LLM_ROUTER_QWEN_MODEL", "ollama/qwen3.5")
+
+
+async def get_llm_response(
+    prompt: str,
+    model: str = "claude",
+    max_tokens: int = 2000,
+    temperature: float = 0.7,
+    fallback_to_qwen: bool = True,
+) -> dict:
+    """Envia prompt para Claude, com fallback automático para Qwen.
+
+    Args:
+        prompt: mensagem do usuário.
+        model: "claude" (tenta Claude primeiro) ou "qwen" (vai direto pro Qwen).
+        fallback_to_qwen: se True (padrão), qualquer falha do Claude
+            (429/quota, timeout, erro de rede, SDK ausente) cai para Qwen
+            automaticamente — sem intervenção manual.
+
+    Returns:
+        {"content": str, "model": str, "stop_reason": str}
+
+    Raises:
+        Exception: se Claude falhar E o fallback estiver desligado, ou se
+            Claude E todos os caminhos de Qwen falharem.
+    """
+    if model == "claude":
+        try:
+            return await _chamar_claude(prompt, max_tokens, temperature)
+        except _ClaudeQuotaError:
+            logger.warning("Claude quota excedida (429), caindo para Qwen")
+        except Exception as e:
+            logger.error(f"Chamada Claude falhou: {e}")
+            if not fallback_to_qwen:
+                raise
+
+        if not fallback_to_qwen:
+            raise Exception("Claude falhou e fallback_to_qwen=False")
+
+        logger.info("Fallback automático: Claude -> Qwen")
+        model = "qwen"
+
+    if model == "qwen":
+        return await _chamar_qwen(prompt, max_tokens, temperature)
+
+    raise Exception(f"Modelo desconhecido: {model}")
+
+
+class _ClaudeQuotaError(Exception):
+    """Marca especificamente estouro de cota (429) do Claude."""
+
+
+async def _chamar_claude(prompt: str, max_tokens: int, temperature: float) -> dict:
+    """Chama Claude via SDK Anthropic direto (mesmo padrão de auditor_fable.py)."""
+    try:
+        from anthropic import Anthropic
+    except ImportError:
+        raise Exception("SDK anthropic não instalado (pip install anthropic)")
+
+    if not ANTHROPIC_API_KEY:
+        raise Exception("ANTHROPIC_API_KEY não configurada")
+
+    import anyio
+
+    def _sync_call():
+        client = Anthropic(api_key=ANTHROPIC_API_KEY)
+        return client.messages.create(
+            model=CLAUDE_MODEL,
+            max_tokens=max_tokens,
+            temperature=temperature,
+            messages=[{"role": "user", "content": prompt}],
+        )
+
+    try:
+        response = await anyio.to_thread.run_sync(_sync_call)
+    except Exception as e:
+        # SDK Anthropic expõe status_code em erros de API (RateLimitError etc.)
+        status_code = getattr(e, "status_code", None)
+        if status_code == 429:
+            raise _ClaudeQuotaError(str(e))
+        raise
+
+    return {
+        "content": response.content[0].text,
+        "model": "claude",
+        "stop_reason": response.stop_reason,
+    }
+
+
+async def _chamar_qwen(prompt: str, max_tokens: int, temperature: float) -> dict:
+    """Chama Qwen local (Ollama); se indisponível, tenta via 9router."""
+    try:
+        return await _chamar_qwen_ollama(prompt, max_tokens, temperature)
+    except Exception as e:
+        logger.warning(f"Qwen via Ollama local falhou ({e}), tentando via 9router")
+
+    try:
+        return await _chamar_qwen_9router(prompt, max_tokens, temperature)
+    except Exception as e:
+        logger.error(f"Qwen via 9router também falhou: {e}")
+        raise Exception(f"Qwen indisponível (Ollama local e 9router falharam): {e}")
+
+
+async def _chamar_qwen_ollama(prompt: str, max_tokens: int, temperature: float) -> dict:
+    async with httpx.AsyncClient(timeout=120) as client:
+        response = await client.post(
+            f"{OLLAMA_URL}/api/generate",
+            json={
+                "model": OLLAMA_MODEL,
+                "prompt": prompt,
+                "stream": False,
+                # think=False: perito-qwen é um modelo "thinking" (Qwen3) e
+                # num_predict conta o raciocínio interno junto com a resposta
+                # final — sem desligar o thinking, prompts curtos truncam
+                # antes de gerar o texto de resposta (response fica vazio).
+                "think": False,
+                "options": {"temperature": temperature, "num_predict": max_tokens},
+            },
+        )
+    response.raise_for_status()
+    data = response.json()
+    return {
+        "content": data.get("response", ""),
+        "model": "qwen-ollama",
+        "stop_reason": data.get("done_reason", "stop"),
+    }
+
+
+async def _chamar_qwen_9router(prompt: str, max_tokens: int, temperature: float) -> dict:
+    headers = {}
+    if LLM_ROUTER_API_KEY:
+        headers["Authorization"] = f"Bearer {LLM_ROUTER_API_KEY}"
+
+    async with httpx.AsyncClient(timeout=60) as client:
+        response = await client.post(
+            f"{LLM_ROUTER_URL}/v1/chat/completions",
+            json={
+                "model": LLM_ROUTER_QWEN_MODEL,
+                "messages": [{"role": "user", "content": prompt}],
+                "max_tokens": max_tokens,
+                "temperature": temperature,
+            },
+            headers=headers,
+        )
+    response.raise_for_status()
+    data = response.json()
+    return {
+        "content": data["choices"][0]["message"]["content"],
+        "model": "qwen-9router",
+        "stop_reason": data["choices"][0].get("finish_reason", "stop"),
+    }
