+++ b/v6/backend/tests/test_llm_fallback.py
@@ -0,0 +1,137 @@
+"""Testes do fallback automático de LLM (Claude -> Qwen).
+
+Não faz chamadas de rede reais: mocka as funções privadas de transporte
+(_chamar_claude, _chamar_qwen_ollama, _chamar_qwen_9router) e valida a
+lógica de decisão de get_llm_response.
+"""
+import pytest
+
+from app.services import llm_router
+
+
+async def test_claude_sucesso_nao_cai_para_qwen(monkeypatch):
+    """Se Claude responde OK, não deve nem tentar Qwen."""
+    chamou_qwen = False
+
+    async def fake_claude(prompt, max_tokens, temperature):
+        return {"content": "resposta claude", "model": "claude", "stop_reason": "end_turn"}
+
+    async def fake_qwen(prompt, max_tokens, temperature):
+        nonlocal chamou_qwen
+        chamou_qwen = True
+        return {"content": "nao deveria chamar", "model": "qwen-ollama", "stop_reason": "stop"}
+
+    monkeypatch.setattr(llm_router, "_chamar_claude", fake_claude)
+    monkeypatch.setattr(llm_router, "_chamar_qwen", fake_qwen)
+
+    resultado = await llm_router.get_llm_response("oi", model="claude")
+
+    assert resultado["model"] == "claude"
+    assert resultado["content"] == "resposta claude"
+    assert chamou_qwen is False
+
+
+async def test_claude_429_cai_automaticamente_para_qwen(monkeypatch):
+    """Cota estourada (429) deve acionar fallback automático para Qwen."""
+
+    async def fake_claude(prompt, max_tokens, temperature):
+        raise llm_router._ClaudeQuotaError("429 rate limit")
+
+    async def fake_qwen(prompt, max_tokens, temperature):
+        return {"content": "resposta qwen", "model": "qwen-ollama", "stop_reason": "stop"}
+
+    monkeypatch.setattr(llm_router, "_chamar_claude", fake_claude)
+    monkeypatch.setattr(llm_router, "_chamar_qwen", fake_qwen)
+
+    resultado = await llm_router.get_llm_response("oi", model="claude")
+
+    assert resultado["model"] == "qwen-ollama"
+    assert resultado["content"] == "resposta qwen"
+
+
+async def test_claude_erro_generico_cai_para_qwen_por_padrao(monkeypatch):
+    """Qualquer falha do Claude (não só 429) deve cair para Qwen por padrão."""
+
+    async def fake_claude(prompt, max_tokens, temperature):
+        raise Exception("timeout de rede")
+
+    async def fake_qwen(prompt, max_tokens, temperature):
+        return {"content": "resposta qwen", "model": "qwen-ollama", "stop_reason": "stop"}
+
+    monkeypatch.setattr(llm_router, "_chamar_claude", fake_claude)
+    monkeypatch.setattr(llm_router, "_chamar_qwen", fake_qwen)
+
+    resultado = await llm_router.get_llm_response("oi", model="claude")
+
+    assert resultado["model"] == "qwen-ollama"
+
+
+async def test_fallback_desligado_propaga_erro_do_claude(monkeypatch):
+    """Com fallback_to_qwen=False, erro do Claude deve subir, sem tentar Qwen."""
+
+    async def fake_claude(prompt, max_tokens, temperature):
+        raise Exception("erro claude")
+
+    monkeypatch.setattr(llm_router, "_chamar_claude", fake_claude)
+
+    with pytest.raises(Exception, match="erro claude"):
+        await llm_router.get_llm_response("oi", model="claude", fallback_to_qwen=False)
+
+
+async def test_qwen_direto_sem_passar_por_claude(monkeypatch):
+    """model='qwen' deve ir direto para Qwen, sem tentar Claude."""
+    chamou_claude = False
+
+    async def fake_claude(prompt, max_tokens, temperature):
+        nonlocal chamou_claude
+        chamou_claude = True
+        return {"content": "x", "model": "claude", "stop_reason": "end_turn"}
+
+    async def fake_qwen(prompt, max_tokens, temperature):
+        return {"content": "resposta qwen direta", "model": "qwen-ollama", "stop_reason": "stop"}
+
+    monkeypatch.setattr(llm_router, "_chamar_claude", fake_claude)
+    monkeypatch.setattr(llm_router, "_chamar_qwen", fake_qwen)
+
+    resultado = await llm_router.get_llm_response("oi", model="qwen")
+
+    assert resultado["model"] == "qwen-ollama"
+    assert chamou_claude is False
+
+
+async def test_qwen_ollama_indisponivel_cai_para_9router(monkeypatch):
+    """Se o Ollama local falhar, _chamar_qwen deve tentar o 9router em seguida."""
+
+    async def fake_ollama(prompt, max_tokens, temperature):
+        raise Exception("Ollama local fora do ar")
+
+    async def fake_9router(prompt, max_tokens, temperature):
+        return {"content": "resposta via 9router", "model": "qwen-9router", "stop_reason": "stop"}
+
+    monkeypatch.setattr(llm_router, "_chamar_qwen_ollama", fake_ollama)
+    monkeypatch.setattr(llm_router, "_chamar_qwen_9router", fake_9router)
+
+    resultado = await llm_router._chamar_qwen("oi", 2000, 0.7)
+
+    assert resultado["model"] == "qwen-9router"
+
+
+async def test_qwen_ollama_e_9router_falham_levanta_excecao(monkeypatch):
+    """Se Ollama local E 9router falharem, deve levantar exceção clara."""
+
+    async def fake_ollama(prompt, max_tokens, temperature):
+        raise Exception("Ollama fora do ar")
+
+    async def fake_9router(prompt, max_tokens, temperature):
+        raise Exception("9router fora do ar")
+
+    monkeypatch.setattr(llm_router, "_chamar_qwen_ollama", fake_ollama)
+    monkeypatch.setattr(llm_router, "_chamar_qwen_9router", fake_9router)
+
+    with pytest.raises(Exception, match="Qwen indisponível"):
+        await llm_router._chamar_qwen("oi", 2000, 0.7)
+
+
+async def test_modelo_desconhecido_levanta_excecao():
+    with pytest.raises(Exception, match="Modelo desconhecido"):
+        await llm_router.get_llm_response("oi", model="gpt4")
